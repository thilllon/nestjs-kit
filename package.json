{
  "name": "nestjs-kit",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --project tsconfig.tools.json && turbo run typecheck",
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "24.19.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
