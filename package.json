{
  "name": "nestjs-kit",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.tools.json && turbo run typecheck",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "hooks:install": "mise exec -- lefthook install",
    "commitlint": "commitlint",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "^21.2.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.23.0",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
