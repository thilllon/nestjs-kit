{
  "name": "nestjs-kit",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --project tsconfig.tools.json && turbo run typecheck",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "test": "vitest run",
    "test:packaging": "vitest run --config vitest.packaging.config.mts",
    "docker:up": "docker compose up --detach --wait",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "^21.2.0",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
