{
  "name": "nestjs-kit",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --project tsconfig.tools.json && turbo run typecheck",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yaml,yml}\"",
    "test": "turbo run test",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "7.0.2"
  }
}
