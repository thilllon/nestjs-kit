{
  "name": "@nestjs-kit/redis",
  "version": "2.0.0",
  "description": "Client-agnostic Redis and Valkey connections for NestJS with isolated named registrations",
  "license": "ISC",
  "author": "thilllon",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/nestjs-kit.git",
    "directory": "packages/nestjskit__redis"
  },
  "homepage": "https://github.com/thilllon/nestjs-kit/tree/main/packages/nestjskit__redis",
  "bugs": {
    "url": "https://github.com/thilllon/nestjs-kit/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "typescript",
    "redis",
    "valkey",
    "ioredis"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.test.json",
    "build": "tsdown --config ../../tsdown.config.mts",
    "test:packaging": "vitest run --config ../../vitest.packaging.config.mts",
    "docker:up": "docker compose up --detach --wait",
    "docker:down": "docker compose down --volumes --remove-orphans",
    "test:e2e": "vitest run --config ../../vitest.e2e.config.mts"
  },
  "module": "./dist/index.mjs",
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "iovalkey": "0.4.0",
    "ioredis": "6.0.0",
    "redis": "6.2.1",
    "@arethetypeswrong/core": "0.18.5",
    "publint": "0.3.24",
    "tsdown": "0.23.0"
  }
}
