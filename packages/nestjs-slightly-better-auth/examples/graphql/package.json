    "test": "vitest run --project unit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/graphql": "14.0.2",
    "@nestjs/platform-express": "12.1.0",
    "better-auth": "1.7.6",
    "graphql": "17.0.2",
    "graphql-ws": "6.3.0",
    "nestjs-slightly-better-auth": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
