{
  "name": "better-auth-graphql-example",
  "version": "0.0.0",
  "private": true,
  "description": "A NestJS Apollo GraphQL application authenticated with nestjs-slightly-better-auth",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.test.json",
