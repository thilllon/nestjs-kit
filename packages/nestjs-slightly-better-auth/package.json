{
  "name": "nestjs-slightly-better-auth",
  "version": "0.0.1",
  "private": true,
  "description": "A Better Auth integration for NestJS, under development",
  "license": "MIT",
  "author": "thilllon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "module-sync": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./platform": {
      "module-sync": {
        "types": "./dist/platform.d.mts",
        "default": "./dist/platform.mjs"
      },
      "import": {
        "types": "./dist/platform.d.mts",
        "default": "./dist/platform.mjs"
      },
      "require": {
        "types": "./dist/platform.d.cts",
        "default": "./dist/platform.cjs"
      }
    },
    "./express": {
      "module-sync": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "module-sync": {
        "types": "./dist/fastify.d.mts",
        "default": "./dist/fastify.mjs"
      },
      "import": {
        "types": "./dist/fastify.d.mts",
        "default": "./dist/fastify.mjs"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/nestjs-kit.git",
    "directory": "packages/nestjs-slightly-better-auth"
  },
  "homepage": "https://github.com/thilllon/nestjs-kit/tree/main/packages/nestjs-slightly-better-auth",
  "bugs": {
    "url": "https://github.com/thilllon/nestjs-kit/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "better-auth",
    "authentication",
    "typescript"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "better-auth": ">=1.7.5 <2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "dependencies": {
    "defu": "6.1.7",
    "path-to-regexp": "8.4.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "better-auth": "1.7.5",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
