{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!examples/**"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!examples/**",
        "$TURBO_ROOT$/tsconfig.test.json"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!examples/**",
        "$TURBO_ROOT$/vitest.shared.mts"
      ]
    }
  }
}
