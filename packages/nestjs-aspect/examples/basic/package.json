{
  "name": "nestjs-aspect-basic-example",
  "version": "0.0.0",
  "private": true,
  "description": "A NestJS application with transaction, retry and call statistics aspects woven around the calls between its providers by nestjs-aspect",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.test.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --project unit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "nestjs-aspect": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
